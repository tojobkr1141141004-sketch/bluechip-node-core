{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": true
  },
  "installCommand": "pnpm install --no-frozen-lockfile --fetch-retries=5 --fetch-timeout=120000 --registry=https://registry.npmjs.org/",
  "buildCommand": "cd apps/web && pnpm exec next build && rm -rf ../../.next && cp -a .next ../../.next",
  "outputDirectory": ".next"
}
